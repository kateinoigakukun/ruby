#!ruby -W0

require 'rubygems'
require 'rdoc/rdoc'

# Make only the output directory relative to the invoked directory.
invoked = Dir.pwd

# Load options and parse files from srcdir.
Dir.chdir(File.dirname(__dir__))

# Generate the ri files of a release package (see RDocPackage).
package = ARGV.delete("--package")
args = ARGV.dup.freeze

new_options = proc do
  options = RDoc::Options.load_options
  options.title = options.title.sub(/Ruby \K.*version/) {
    File.read("include/ruby/version.h")
      .scan(/^ *# *define +RUBY_API_VERSION_(MAJOR|MINOR) +(\d+)/)
      .sort # "MAJOR" < "MINOR", fortunately
      .to_h.values.join(".")
  }
  options.parse args.dup

  options.singleton_class.define_method(:finish) do
    super()
    @op_dir = File.expand_path(@op_dir, invoked)
  end
  options
end
options = new_options.()

# rbconfig.rb is generated in the build directory, and .document lists it
# as a file of srcdir.  Document the one of an out-of-tree build under that
# name too, not its path, which the files of RbConfig and its methods would
# record, and parse it once and in the same order as in-tree.
module RDocBuildRbconfig
  NAME = "rbconfig.rb"

  attr_accessor :build_rbconfig

  def normalized_file_list(files, force_doc = false, exclude = nil)
    list = super
    if force_doc and (path = build_rbconfig) and !list.key?(NAME) and
       (stat = File.stat(path) rescue nil)
      last = @last_modified[NAME]
      list[NAME] = (stat.mtime unless last and stat.mtime.to_i <= last.to_i)
    end
    list
  end

  def parse_file(filename)
    return super unless filename == NAME and (path = build_rbconfig)
    Dir.chdir(File.dirname(path)) {super}
  end

  def relative_path_for(filename)
    filename == NAME && build_rbconfig ? filename.dup : super
  end
end
RDoc::RDoc.prepend(RDocBuildRbconfig)

build_rbconfig = File.join(invoked, RDocBuildRbconfig::NAME)
if !File.exist?(build_rbconfig) or File.identical?(build_rbconfig, RDocBuildRbconfig::NAME)
  build_rbconfig = nil          # in-tree, .document finds it
end

# The number of processes to write ri files with: the -j of make (in
# MAKEFLAGS), the number of processors (at most 8) under make -j without a
# number or with only a jobserver, else 1.
def rdoc_jobs
  flags = ENV["MAKEFLAGS"].to_s
  jobs = flags.scan(/(?:\A|\s)(?:-j|--jobs=?)(\d*)(?=\s|\z)/).map {|n,| n.to_i}
  if (n = jobs.find(&:positive?))
    return n
  elsif jobs.empty? and !/(?:\A|\s)--jobserver-(?:auth|fds)=/.match?(flags)
    return 1
  end
  require 'etc'
  [Etc.nprocessors, 8].min
rescue LoadError
  4
end

# On a case-insensitive file system, the files of names that differ only
# in case (Net::HTTPGatewayTimeOut and Net::HTTPGatewayTimeout) are one.
# RDoc::Store#save_class merged the class it saves with the file it finds,
# there that of the other class, and put the object it loaded in the store,
# where the files saved later referred to it (Net/cdesc-Net.ri): the ri
# files depended on the file system.  Keep the file of the name saved first
# in this run instead, and save the others as a dry run, as if they had no
# file: the files written are those of a case-sensitive file system, but
# only the first of those that are one.
module RDocCaseCollision
  def save_class(klass)
    shadowed(class_file(klass.full_name)) {super}
  end

  def save_method(klass, method)
    shadowed(method_file(klass.full_name, method.full_name)) {super}
  end

  def save_page(page)
    return super unless page.text?
    shadowed(page_file(page.full_name)) {super}
  end

  def load_class_data(klass_name)
    if @shadowed and class_file(klass_name) == @shadowed
      raise RDoc::Store::MissingFileError.new(self, @shadowed, klass_name)
    end
    super
  end

  private

  def shadowed(path)
    return yield if @dry_run
    first = (@saved_paths ||= {})[path.downcase] ||= path
    return yield if first == path or !File.identical?(first, path)
    begin
      @dry_run, @shadowed = true, path
      yield
    ensure
      @dry_run = @shadowed = nil
    end
  end
end
RDoc::Store.prepend(RDocCaseCollision)

# Writing the ri files (RDoc::Store#save) takes most of the time: split it
# among processes, each writing the files of some classes and modules (with
# their methods and attributes) and pages once this process has run
# RDoc::Store#save as a dry run for the cache, which it writes last.
#
# RDoc::Store#save_class merges what it saves with the file it finds, of an
# earlier run, which the dry run reads before any is written.  The classes
# and modules whose names differ only in case, and so the others of their
# top-level namespace, are written by this process, in its dry run, for
# RDocCaseCollision to see them in the order of RDoc::Store#save.  Each
# other top-level namespace is written by one process in that order.  The
# directories are made beforehand, in that order too: on a case-insensitive
# file system the name of a directory is the first one it is made with
# (File/ for the class File and for the pages in doc/file/).
module RDocParallelSave
  attr_accessor :save_jobs

  def save
    jobs = save_jobs.to_i
    return super if jobs < 2 or @dry_run or !Process.respond_to?(:fork)
    size = ->(klass) {1 + klass.method_list.size + klass.attributes.size}
    groups = all_classes_and_modules.group_by {|klass| klass.full_name[/\A[^:]*/].downcase}
    owner = {}
    loads = Array.new(jobs, 0)
    groups.sort_by {|_, klasses| -klasses.sum(&size)}.each do |_, klasses|
      names = klasses.map {|klass| klass.full_name.downcase}
      share = names.uniq.size < names.size ? :self : loads.index(loads.min)
      klasses.each {|klass| owner[klass.full_name] = share}
      loads[share] += klasses.sum(&size) unless share == :self
    end
    all_files.each_with_index {|file, i| owner[file] = i % jobs}
    all_classes_and_modules.each {|klass| FileUtils.mkdir_p(class_path(klass.full_name))}
    all_files.each {|file| FileUtils.mkdir_p(File.dirname(page_file(file.full_name))) if file.text?}
    writers = []
    pids = Array.new(jobs) do |share|
      r, w = IO.pipe
      pid = fork do
        w.close
        writers.each(&:close)
        r.read                  # until the dry run has read the files
        @save_owner, @save_share = owner, share
        super()
        exit!(true)
      end
      r.close
      writers << w
      pid
    end
    begin
      @save_owner, @save_share = owner, :self
      super()
    ensure
      @save_owner = @save_share = nil
      writers.each(&:close)
      failed = pids.count {|pid| !Process.wait2(pid)[1].success?}
    end
    raise "#{failed} of #{jobs} processes failed to write ri files" if failed > 0
    save_cache
  end

  def save_class(klass)
    save_as(@save_owner && @save_owner[klass.full_name]) {super}
  end

  def save_method(klass, method)
    save_as(@save_owner && @save_owner[klass.full_name]) {super}
  end

  def save_page(page)
    save_as(@save_owner && @save_owner[page]) {super}
  end

  def save_cache
    super unless @save_owner
  end

  private

  def save_as(share)
    if !@save_owner or share == @save_share
      yield
    elsif @save_share == :self      # the dry run
      begin
        @dry_run = true
        yield
      ensure
        @dry_run = false
      end
    end
  end
end
RDoc::Store.prepend(RDocParallelSave)

# The ri files a release package ships in doc/ri of srcdir, generated by
# tool/make-snapshot (`make rdoc-package`) for `make install` to copy them
# instead of generating them.  They depend on the versions of ruby and
# rdoc, on the options and on the files parsed, not on the platform, the
# configuration or the build directory.  doc/ri/.stamp records those.
#
# doc/ri holds the files as generated on a case-insensitive file system
# (see RDocCaseCollision), so that they unpack whole anywhere.  The stamp
# records how those of a case-sensitive file system differ, with "case"
# lines of the name of a file there and the file it is: one in doc/ri
# under another name, or one a case-insensitive file system has not, in
# doc/ri/.case/.
module RDocPackage
  DIR = "doc/ri"
  STAMP = File.join(DIR, ".stamp")
  CASES = ".case"
  # What the files depend on besides the files parsed: the rbconfig.rb of
  # the build directory is documented from tool/mkconfig.rb.
  INPUTS = %w[.rdoc_options include/ruby/version.h tool/mkconfig.rb tool/rdoc-srcdir]

  module_function

  # The options that change the ri files, not where they go or whether
  # they are generated again.
  def significant(args)
    args = args.dup
    list = []
    while arg = args.shift
      case arg
      when "--op", "-o" then args.shift
      when /\A--op=/, "--force-update", "--no-force-update", "--package"
      else list << arg
      end
    end
    list
  end

  # The lines of the stamp about the generation: the versions, the
  # options, and a digest of each file parsed.  +rdoc+ has the options
  # the files are listed with.
  def stamp(rdoc, args)
    require 'digest/sha2'
    revision = File.foreach("gems/bundled_gems").map(&:split).find {|name,| name == "rdoc"}&.[](3) rescue nil
    lines = ["ruby #{RUBY_VERSION}", "rdoc #{RDoc::VERSION} #{revision || '-'} #{library_digest}",
             "options #{significant(args).join(' ')}"]
    files = rdoc.gather_files(rdoc.options.files) - [RDocBuildRbconfig::NAME] | INPUTS
    files.sort.each {|file| lines << "#{Digest::SHA256.file(file).hexdigest}  #{file}"}
    lines
  end

  # A digest of the library of rdoc, whose files a revision may not name
  # (a gem built from another checkout).
  def library_digest
    lib = File.expand_path("../..", RDoc::RDoc.instance_method(:document).source_location[0])
    files = Dir.glob(%w[rdoc.rb rdoc/**/*.rb], base: lib).sort
    Digest::SHA256.hexdigest(files.map {|file| "#{Digest::SHA256.file(File.join(lib, file))}  #{file}\n"}.join)
  end

  # The files RDoc::Store#save writes, in its order, relative to its
  # directory.
  def save_order(store)
    paths = []
    store.all_classes_and_modules.each do |klass|
      paths << store.class_file(klass.full_name)
      klass.each_method {|method| paths << store.method_file(klass.full_name, method.full_name)}
      klass.attributes.each {|attr| paths << store.method_file(klass.full_name, attr.full_name)}
    end
    store.all_files.each {|page| paths << store.page_file(page.full_name) if page.text?}
    paths << store.cache_path
    paths.map {|path| Pathname(path).cleanpath.to_s}.uniq
  end

  def case_insensitive?(dir)
    File.exist?(File.join(dir, "created.rid")) and File.exist?(File.join(dir, "CREATED.RID"))
  end

  # Writes the files of +store+ in +op_dir+, freshly generated there on a
  # case-sensitive file system, to DIR with the stamp.
  def write(store, op_dir, stamp)
    if case_insensitive?(op_dir)
      warn "#{$0}: not packaging the ri files generated on a case-insensitive file system"
      return
    end
    order = save_order(store)
    found = Dir.glob("**/*", File::FNM_DOTMATCH, base: op_dir).reject {|file|
      file == "created.rid" or !File.file?(File.join(op_dir, file))
    }
    unless found.sort == order.sort
      abort "#{$0}: ri files other than those saved: #{(found - order | order - found).first(3).join(', ')}"
    end
    FileUtils.rm_rf(DIR)
    spelled = {}
    kept = {}
    cases = []
    count = bytes = 0
    order.each do |file|
      name = nil
      file.split("/").each do |part|
        name = spelled[name ? "#{name.downcase}/#{part.downcase}" : part.downcase] ||=
          name ? "#{name}/#{part}" : part
      end
      src = File.join(op_dir, file)
      if kept[name.downcase]
        cases << [file, dest = File.join(CASES, (cases.count {|_, d| d.start_with?(CASES)} + 1).to_s)]
      else
        kept[name.downcase] = true
        cases << [file, name] unless name == file
        count += 1
        bytes += File.size(src)
        dest = name
      end
      FileUtils.mkdir_p(File.dirname(dest = File.join(DIR, dest)))
      FileUtils.cp(src, dest)
    end
    File.write(STAMP, [stamp[0, 3], "files #{count} #{bytes}",
                       cases.map {|file, dest| "case #{file}\t#{dest}"}, stamp[3..]].join("\n") + "\n")
    puts "Packaged #{count} ri files in #{DIR}"
  end

  # Makes +op_dir+ of the files in DIR, as the generation +rdoc+ would
  # make it on its file system, if the stamp matches it; returns false,
  # and leaves +op_dir+ alone, if not.  The files are hard links to those
  # in DIR, or copies across file systems; created.rid lists the files
  # parsed as after a generation.
  def reuse(rdoc, args, op_dir)
    return false unless File.file?(STAMP)
    data, generation = File.readlines(STAMP, chomp: true).partition {|line| line.start_with?("files ", "case ")}
    current = stamp(rdoc, args)
    unless generation == current
      line = (generation - current).first || (current - generation).first
      puts "#{STAMP} does not match (#{line[/\S+\z/]}): generating the ri files"
      return false
    end
    files, bytes = data.shift.split.drop(1).map(&:to_i)
    FileUtils.rm_rf(op_dir)
    FileUtils.mkdir_p(op_dir)
    rdoc.update_output_dir(op_dir, Time.now, rdoc.last_modified)
    names = {}
    extra = []
    unless case_insensitive?(op_dir)
      data.each do |line|
        file, src = line.delete_prefix("case ").split("\t", 2)
        src.start_with?("#{CASES}/") ? extra << [src, file] : names[src] = file
      end
    end
    dirs = {op_dir => true}
    link = true
    put = proc do |src, file|
      dest = File.join(op_dir, file)
      dir = File.dirname(dest)
      dirs[dir] ||= FileUtils.mkdir_p(dir)
      begin
        link &&= File.link(src, dest)
      rescue SystemCallError
        link = false
      end
      IO.copy_stream(src, dest) unless link
    end
    Dir.glob("**/*", base: DIR) do |file|
      src = File.join(DIR, file)
      next unless File.file?(src)
      files -= 1
      bytes -= File.size(src)
      put.(src, names[file] || file)
    end
    extra.each {|src, file| put.(File.join(DIR, src), file)}
    unless files == 0 and bytes == 0
      FileUtils.rm_rf(op_dir)
      puts "#{DIR} has other files than #{STAMP} says: generating the ri files"
      return false
    end
    puts "Using the ri files of #{DIR}"
    true
  end

  # Whether +op_dir+ has files of DIR, as #reuse makes it.
  def linked?(op_dir)
    File.identical?(File.join(op_dir, "cache.ri"), File.join(DIR, "cache.ri"))
  end
end

# A listing of the files parsed, with the options of a generation.
new_rdoc = proc do
  rdoc = RDoc::RDoc.new
  rdoc.build_rbconfig = build_rbconfig
  (rdoc.options = new_options.()).finish
  rdoc
end

op_dir = File.expand_path(options.op_dir || "doc", invoked)
if package
  FileUtils.rm_rf(op_dir)       # a fresh generation
elsif options.generator_name == "ri" and !options.dry_run
  # the files of the package when they are those of this generation
  exit if RDocPackage.reuse(new_rdoc.(), args, op_dir)
  # a generation writes in the files it finds, not in those of doc/ri
  FileUtils.rm_rf(op_dir) if RDocPackage.linked?(op_dir)
end

rdoc = RDoc::RDoc.new
rdoc.build_rbconfig = build_rbconfig
rdoc.singleton_class.define_method(:generate) do
  @store.save_jobs = rdoc_jobs
  super()
  RDocPackage.write(@store, @options.op_dir, RDocPackage.stamp(new_rdoc.(), args)) if package
end

# Do not hide errors when generating documents of Ruby itself.
rdoc.document options
