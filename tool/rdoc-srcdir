#!ruby -W0

require 'rubygems'
require 'rdoc/rdoc'

# Make only the output directory relative to the invoked directory.
invoked = Dir.pwd

# Load options and parse files from srcdir.
Dir.chdir(File.dirname(__dir__))

options = RDoc::Options.load_options
options.title = options.title.sub(/Ruby \K.*version/) {
  File.read("include/ruby/version.h")
    .scan(/^ *# *define +RUBY_API_VERSION_(MAJOR|MINOR) +(\d+)/)
    .sort # "MAJOR" < "MINOR", fortunately
    .to_h.values.join(".")
}
options.parse ARGV

# rbconfig.rb is generated in the build directory, and .document lists it
# as a file of srcdir.  Document the one of an out-of-tree build under that
# name too, not its path, which the files of RbConfig and its methods would
# record, and parse it once and in the same order as in-tree.
module RDocBuildRbconfig
  NAME = "rbconfig.rb"

  attr_accessor :build_rbconfig

  def normalized_file_list(files, force_doc = false, exclude = nil)
    list = super
    if force_doc and (path = build_rbconfig) and !list.key?(NAME) and
       (stat = File.stat(path) rescue nil)
      last = @last_modified[NAME]
      list[NAME] = (stat.mtime unless last and stat.mtime.to_i <= last.to_i)
    end
    list
  end

  def parse_file(filename)
    return super unless filename == NAME and (path = build_rbconfig)
    Dir.chdir(File.dirname(path)) {super}
  end

  def relative_path_for(filename)
    filename == NAME && build_rbconfig ? filename.dup : super
  end
end
RDoc::RDoc.prepend(RDocBuildRbconfig)

build_rbconfig = File.join(invoked, RDocBuildRbconfig::NAME)
if !File.exist?(build_rbconfig) or File.identical?(build_rbconfig, RDocBuildRbconfig::NAME)
  build_rbconfig = nil          # in-tree, .document finds it
end

options.singleton_class.define_method(:finish) do
  super()
  @op_dir = File.expand_path(@op_dir, invoked)
end

# The number of processes to write ri files with: the -j of make (in
# MAKEFLAGS), the number of processors (at most 8) under make -j without a
# number or with only a jobserver, else 1.
def rdoc_jobs
  flags = ENV["MAKEFLAGS"].to_s
  jobs = flags.scan(/(?:\A|\s)(?:-j|--jobs=?)(\d*)(?=\s|\z)/).map {|n,| n.to_i}
  if (n = jobs.find(&:positive?))
    return n
  elsif jobs.empty? and !/(?:\A|\s)--jobserver-(?:auth|fds)=/.match?(flags)
    return 1
  end
  require 'etc'
  [Etc.nprocessors, 8].min
rescue LoadError
  4
end

# Writing the ri files (RDoc::Store#save) takes most of the time: split it
# among processes, each writing the files of some classes and modules (with
# their methods and attributes) and pages once this process has run
# RDoc::Store#save as a dry run for the cache, which it writes last.
#
# RDoc::Store#save_class merges what it saves with the file it finds.  That
# is a file of an earlier run, which the dry run reads before any is
# written, or, on a case-insensitive file system, the file of another class
# or module whose name differs only in case: this process writes those, and
# the other classes and modules of their top-level namespace, which the
# merge may change, in its dry run.  Each other top-level namespace is
# written by one process in the order of RDoc::Store#save.
module RDocParallelSave
  attr_accessor :save_jobs

  def save
    jobs = save_jobs.to_i
    return super if jobs < 2 or @dry_run or !Process.respond_to?(:fork)
    size = ->(klass) {1 + klass.method_list.size + klass.attributes.size}
    groups = all_classes_and_modules.group_by {|klass| klass.full_name[/\A[^:]*/].downcase}
    owner = {}
    loads = Array.new(jobs, 0)
    groups.sort_by {|_, klasses| -klasses.sum(&size)}.each do |_, klasses|
      names = klasses.map {|klass| klass.full_name.downcase}
      share = names.uniq.size < names.size ? :self : loads.index(loads.min)
      klasses.each {|klass| owner[klass.full_name] = share}
      loads[share] += klasses.sum(&size) unless share == :self
    end
    all_files.each_with_index {|file, i| owner[file] = i % jobs}
    writers = []
    pids = Array.new(jobs) do |share|
      r, w = IO.pipe
      pid = fork do
        w.close
        writers.each(&:close)
        r.read                  # until the dry run has read the files
        @save_owner, @save_share = owner, share
        super()
        exit!(true)
      end
      r.close
      writers << w
      pid
    end
    begin
      @save_owner, @save_share = owner, :self
      super()
    ensure
      @save_owner = @save_share = nil
      writers.each(&:close)
      failed = pids.count {|pid| !Process.wait2(pid)[1].success?}
    end
    raise "#{failed} of #{jobs} processes failed to write ri files" if failed > 0
    save_cache
  end

  def save_class(klass)
    save_as(@save_owner && @save_owner[klass.full_name]) {super}
  end

  def save_method(klass, method)
    save_as(@save_owner && @save_owner[klass.full_name]) {super}
  end

  def save_page(page)
    save_as(@save_owner && @save_owner[page]) {super}
  end

  def save_cache
    super unless @save_owner
  end

  private

  def save_as(share)
    if !@save_owner or share == @save_share
      yield
    elsif @save_share == :self      # the dry run
      begin
        @dry_run = true
        yield
      ensure
        @dry_run = false
      end
    end
  end
end
RDoc::Store.prepend(RDocParallelSave)

rdoc = RDoc::RDoc.new
rdoc.build_rbconfig = build_rbconfig
rdoc.singleton_class.define_method(:generate) do
  @store.save_jobs = rdoc_jobs
  super()
end

# Do not hide errors when generating documents of Ruby itself.
rdoc.document options
